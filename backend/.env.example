# env
ENVIRONMENT="dev"
CORS_ALLOWED_ORIGINS='["http://127.0.0.1:4173","http://127.0.0.1:4174","http://localhost:4173","http://localhost:4174"]'
# databse
# Set DATABASE_TYPE="sqlite" for local development without starting PostgreSQL/MySQL.
DATABASE_TYPE="postgresql"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=5432
DATABASE_USER="admin"
DATABASE_PASSWORD="admin123"
DATABASE_SCHEMA="scheme_backend"
DATABASE_SQLITE_PATH="local_dev.db"
# minio
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="admin123"
RESOURCE_BUCKET="scheme-resources"
# engine
ENGINE_CLIENT_MODE="fake"
ENGINE_ENDPOINT="http://localhost:8000"
ENGINE_RABBITMQ_HOST="localhost"
ENGINE_RABBITMQ_PORT=5672
ENGINE_RABBITMQ_USER="guest"
ENGINE_RABBITMQ_PASSWORD="guest"
ENGINE_RABBITMQ_QUEUE_NAME="info"
FAKE_ENGINE_PENDING_SECONDS=0.1
FAKE_ENGINE_TASK_DURATION_SECONDS=10
FAKE_ENGINE_STOPPING_SECONDS=0.1
FAKE_ENGINE_LOG_INTERVAL_SECONDS=1
FAKE_ENGINE_SIM_TIME_INTERVAL_SECONDS=1
ENGINE_EVENT_POLL_INTERVAL_SECONDS=0.05
RUNTIME_SSE_HEARTBEAT_SECONDS=15
